# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agri_marketplace?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email (SMTP) - used for OTP delivery, order emails, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
MAIL_FROM="Agri Marketplace <no-reply@agrimarketplace.com>"

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# Google OAuth (Google Sign-In on the frontend sends an idToken here to verify)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20
