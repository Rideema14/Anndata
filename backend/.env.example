# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Checkout pricing — flat platform/shipping fee (rupees), the subtotal at/
# above which it's waived, and the flat tax rate (e.g. 0.05 = 5%). Used by
# order checkout, machinery bookings, and the seed store checkout.
PLATFORM_FEE=49
FREE_SHIPPING_THRESHOLD=999
TAX_RATE=0.05

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agri_marketplace?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email (EmailJS) - used for OTP delivery, order emails, etc.
# Nodemailer/SMTP does NOT work on Vercel (its serverless functions block
# outbound SMTP ports), so email goes through EmailJS's HTTPS API instead.
# Setup (one-time, in the EmailJS dashboard at https://dashboard.emailjs.com):
#   1. Email Services -> Add New Service -> connect Gmail/Outlook/SMTP/etc.
#      Copy the Service ID it gives you into EMAILJS_SERVICE_ID below.
#   2. Email Templates -> Create New Template. This app sends every email
#      (OTPs, order updates, ...) through this ONE template, passing in
#      variables it fills in. Set the template's "To email" field to
#      {{to_email}}, then in the template's HTML source use:
#        Subject:  {{subject}}
#        Body:     {{{html_body}}}   <- triple braces so the HTML this app
#                                        generates isn't escaped
#      (text_body and from_name are also available if you want a plain-text
#      part or a custom From display name.)
#      Copy the Template ID into EMAILJS_TEMPLATE_ID below.
#   3. Account -> General -> copy your Public Key into EMAILJS_PUBLIC_KEY.
#   4. Account -> Security -> API Keys -> copy your Private Key into
#      EMAILJS_PRIVATE_KEY. This is what authorizes sends from a server
#      instead of a browser; without it you'd have to enable "Allow
#      non-browser requests" on the account instead, which is less safe.
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
MAIL_FROM_NAME="Agri Marketplace"
MAIL_FROM_EMAIL=no-reply@agrimarketplace.com

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# Google OAuth (Google Sign-In on the frontend sends an idToken here to verify)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Shipment tracking (17TRACK — https://api.17track.net) — used to verify
# seller-submitted AWBs and poll/receive courier status updates (pickup,
# transit, delivery). See modules/order/tracking.service.ts.
#
# Previously TrackingMore, then KeyDelivery (https://www.kd100.com) — both
# dropped out: TrackingMore's live Tracking API/Webhook access moved off its
# permanent Free plan in mid-2026, and KeyDelivery's account registration
# stopped completing reliably after that. 17TRACK still offers a real
# Tracking API + webhook on a free quota with no card required. Sign up at
# https://api.17track.net, then grab your key at
# https://api.17track.net/admin/settings.
# Leave TRACK17_API_KEY blank in dev to run with format-validation only
# (AWBs won't be verified against a real carrier, and shipments stay flagged
# "provider unavailable" until synced). Set TRACKING_SIMULATE=true instead
# to auto-verify AWBs and generate a fake but internally-consistent tracking
# timeline for development/testing — this is the same simulation the seed
# script uses, and it never runs when TRACK17_API_KEY is set.
TRACK17_API_KEY=
TRACKING_SIMULATE=false
# How often the fallback polling cron checks every non-terminal shipment.
# 17TRACK's API is rate-limited to 3 requests/second account-wide — leave
# some headroom if you raise this and have a lot of non-terminal shipments.
TRACKING_POLL_MINUTES=10
# Optional. Enables the POST /api/v1/orders/webhooks/track17 receiver for
# real-time updates instead of waiting for the next poll (the cron still
# runs as a fallback either way). Unlike KeyDelivery's per-request
# webhook_url, 17TRACK pushes to a single URL you register ONCE in its
# dashboard (Settings page). 17TRACK doesn't sign its webhook payloads at
# all, so we authenticate it ourselves: generate any random string for
# TRACKING_WEBHOOK_TOKEN, then set TRACKING_WEBHOOK_URL to your public
# endpoint with that token as a query param — e.g.
# https://api.yourapp.com/api/v1/orders/webhooks/track17?token=<TRACKING_WEBHOOK_TOKEN>
# — and paste that exact URL into the 17TRACK dashboard. See
# verifyTrack17WebhookToken() in tracking.service.ts.
TRACKING_WEBHOOK_URL=
TRACKING_WEBHOOK_TOKEN=

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20

# Weather (Open-Meteo — free, no API key required; override only for a self-hosted instance)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_MINUTES=30

# Mandi price sync (optional) — data.gov.in's Agmarknet dataset requires its own API key.
# Register at https://data.gov.in (My Account -> API Access) and find the current resource
# ID on the "Variety-wise Daily Market Prices of Commodity" dataset page. Leave both blank
# to skip external sync entirely and manage mandi prices via the admin CRUD endpoints instead.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource

# AI Farm Advisory Suite — Google Gemini API (free tier, no card required).
# Get a key at https://aistudio.google.com/apikey. One key powers chat, crop/soil
# advisory, disease-detection image analysis, voice transcription, and TTS replies.
# Free tier is rate-limited (roughly single-digit to low-double-digit requests/minute,
# capped per day) — fine for dev/small-scale use; requests just start returning 429s
# once you're over the limit rather than silently billing you.
GEMINI_API_KEY=your_gemini_api_key
# All optional — sensible free-tier defaults are baked in if you leave these unset.
# GEMINI_MODEL=gemini-2.5-flash            # swap to gemini-2.5-flash-lite for a higher daily quota
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore

# AI Farm Advisory Suite — Groq API (optional, but recommended for speed).
# Free tier, no card required: https://console.groq.com/keys. When set, text
# chat/advisory (crop, fertilizer, irrigation, rotation, weather, soil, and
# open chat) and voice transcription route through Groq instead of Gemini,
# since Groq's LPU inference is several times faster for both. Disease
# detection (image analysis) always stays on Gemini regardless of this
# setting, and if Groq errors or rate-limits, requests fall back to Gemini
# automatically. Leave blank to run on Gemini only.
GROQ_API_KEY=your_groq_api_key
# All optional — sensible defaults are baked in if you leave these unset.
# GROQ_CHAT_MODEL=openai/gpt-oss-120b       # swap to openai/gpt-oss-20b for even higher free-tier throughput
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Set to "groq" to use Groq's Orpheus voices for the voice assistant's
# spoken replies instead of Gemini's. Orpheus voices are more expressive,
# but are billed per character with no confirmed free tier — Gemini TTS
# stays the free default. See config/env.ts for details.
# AI_TTS_PROVIDER=groq
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=autumn