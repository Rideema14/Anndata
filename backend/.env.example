# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agri_marketplace?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email (SMTP) - used for OTP delivery, order emails, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
MAIL_FROM="Agri Marketplace <no-reply@agrimarketplace.com>"

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# Google OAuth (Google Sign-In on the frontend sends an idToken here to verify)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20

# Weather (Open-Meteo — free, no API key required; override only for a self-hosted instance)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_MINUTES=30

# Mandi price sync (optional) — data.gov.in's Agmarknet dataset requires its own API key.
# Register at https://data.gov.in (My Account -> API Access) and find the current resource
# ID on the "Variety-wise Daily Market Prices of Commodity" dataset page. Leave both blank
# to skip external sync entirely and manage mandi prices via the admin CRUD endpoints instead.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource

# AI Farm Advisory Suite — Google Gemini API (free tier, no card required).
# Get a key at https://aistudio.google.com/apikey. One key powers chat, crop/soil
# advisory, disease-detection image analysis, voice transcription, and TTS replies.
# Free tier is rate-limited (roughly single-digit to low-double-digit requests/minute,
# capped per day) — fine for dev/small-scale use; requests just start returning 429s
# once you're over the limit rather than silently billing you.
GEMINI_API_KEY=your_gemini_api_key
# All optional — sensible free-tier defaults are baked in if you leave these unset.
# GEMINI_MODEL=gemini-2.5-flash            # swap to gemini-2.5-flash-lite for a higher daily quota
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
