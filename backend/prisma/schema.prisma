// Prisma schema for the Agri Marketplace backend.
// Phase 1: User Management & Auth, Marketplace Catalog, Cart, Orders, Payments (Razorpay).
// Later phases (Seed Store, Land Marketplace, Machinery Rental, Mandi Price Intelligence,
// AI Advisory, Weather, Seller Analytics, Notifications, Admin) will extend this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SellerVerificationStatus {
  UNSUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ORDER_STATUS
  PAYMENT
  SELLER_VERIFICATION
  REVIEW
  PRICE_ALERT
  GENERAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum FeedbackCategory {
  BUG
  FEATURE_REQUEST
  COMPLAINT
  GENERAL
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum MandiPriceSource {
  ADMIN
  EXTERNAL_API
}

enum PriceAlertCondition {
  ABOVE
  BELOW
}

enum MandiPriceType {
  MIN
  MAX
  MODAL
}

enum MachineryBookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// 3.1 User Management & Authentication
// ---------------------------------------------------------------------------

model User {
  id                     String       @id @default(uuid())
  name                   String
  email                  String       @unique
  phone                  String?      @unique
  passwordHash           String?
  role                   Role         @default(BUYER)
  authProvider           AuthProvider @default(LOCAL)
  googleId               String?      @unique
  googlePicture          String?
  profileImage           String?
  profileImagePublicId   String?
  isEmailVerified        Boolean      @default(false)
  isPhoneVerified        Boolean      @default(false)
  isActive               Boolean      @default(true)
  latitude               Float?
  longitude              Float?

  // Email OTP (registration verification, password reset, login 2FA-ish flows)
  otpCodeHash            String?
  otpExpiresAt           DateTime?
  otpPurpose             String?      // REGISTER | RESET_PASSWORD
  otpAttempts            Int          @default(0)

  createdAt              DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  addresses              Address[]
  loginHistory           LoginHistory[]
  refreshTokens          RefreshToken[]
  products               Product[]      @relation("SellerProducts")
  reviews                Review[]
  wishlist               Wishlist[]
  cart                   Cart?
  orders                 Order[]
  payments               Payment[]
  orderStatusChanges     OrderStatusHistory[] @relation("StatusChangedBy")
  sellerProfile          SellerProfile?
  notifications          Notification[]
  notificationPreference NotificationPreference?
  feedbacks              Feedback[]
  verificationsReviewed  SellerProfile[] @relation("VerificationReviewedBy")
  favoriteMandis         FavoriteMandi[]
  mandiPriceAlerts       MandiPriceAlert[]
  sellerSeeds            Seed[]                   @relation("SellerSeeds")
  seedReviews            SeedReview[]
  seedWishlist           SeedWishlist[]
  seedCart               SeedCart?
  seedOrders             SeedOrder[]
  seedPayments           SeedPayment[]
  seedOrderStatusChanges SeedOrderStatusHistory[] @relation("SeedStatusChangedBy")
  sellerMachinery        Machinery[]              @relation("SellerMachinery")
  machineryBookings      MachineryBooking[]
  machineryReviews       MachineryReview[]
  machineryPayments      MachineryPayment[]
  machineryStatusChanges MachineryBookingStatusHistory[] @relation("MachineryStatusChangedBy")

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  revoked    Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  success   Boolean
  reason    String?
  loginAt   DateTime @default(now())

  @@index([userId])
  @@map("login_history")
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("Home")
  fullName      String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String
  country       String   @default("India")
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]
  seedOrders    SeedOrder[]
  machineryBookings MachineryBooking[]

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// 3.2 Marketplace — Multi-Category Product Catalog
// ---------------------------------------------------------------------------

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  slug          String        @unique
  description   String?
  imageUrl      String?
  imagePublicId String?       // Cloudinary public_id, needed to delete the asset on replace/delete
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subCategories SubCategory[]
  products      Product[]

  @@map("categories")
}

model SubCategory {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("sub_categories")
}

model Product {
  id             String        @id @default(uuid())
  sellerId       String
  seller         User          @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  subCategoryId  String?
  subCategory    SubCategory?  @relation(fields: [subCategoryId], references: [id])

  name           String
  slug           String        @unique
  description    String?
  brand          String?
  price          Decimal       @db.Decimal(12, 2)
  discountPrice  Decimal?      @db.Decimal(12, 2)
  stock          Int           @default(0)
  unit           String        @default("piece") // kg, litre, piece, bag, quintal...
  specifications Json?         // flexible per-category attributes (e.g. seed variety, HP for machinery)
  latitude       Float?
  longitude      Float?
  isActive       Boolean       @default(true)
  avgRating      Float         @default(0)
  reviewCount    Int           @default(0)
  viewCount      Int           @default(0)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  images         ProductImage[]
  variants       ProductVariant[]
  reviews        Review[]
  wishlistedBy   Wishlist[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([sellerId])
  @@index([isActive])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?  // Cloudinary public_id, needed to delete the asset later
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String   // e.g. "5kg pack", "10 HP"
  sku        String?  @unique
  price      Decimal  @db.Decimal(12, 2)
  stock      Int      @default(0)
  attributes Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int      // 1-5
  comment    String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist")
}

// ---------------------------------------------------------------------------
// 3.3 Orders, Cart & Checkout
// ---------------------------------------------------------------------------

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id         String          @id @default(uuid())
  cartId     String
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int             @default(1)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  addressId     String
  address       Address       @relation(fields: [addressId], references: [id])
  status        OrderStatus   @default(PENDING)

  subtotal      Decimal       @db.Decimal(12, 2)
  shippingFee   Decimal       @db.Decimal(12, 2) @default(0)
  tax           Decimal       @db.Decimal(12, 2) @default(0)
  discount      Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount   Decimal       @db.Decimal(12, 2)

  notes         String?
  cancelReason  String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payment       Payment?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String          @id @default(uuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  productName  String          // snapshot at time of order
  quantity     Int
  unitPrice    Decimal         @db.Decimal(12, 2)
  totalPrice   Decimal         @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id            String      @id @default(uuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        OrderStatus
  note          String?
  changedById   String?
  changedBy     User?       @relation("StatusChangedBy", fields: [changedById], references: [id])
  changedAt     DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// 3.4 Payments (Razorpay)
// ---------------------------------------------------------------------------

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId            String
  user              User          @relation(fields: [userId], references: [id])

  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpaySignature String?

  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String?       // upi, card, netbanking, wallet...
  failureReason     String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([razorpayOrderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// 3.11 Seller Management & Analytics
// ---------------------------------------------------------------------------

model SellerProfile {
  id                  String                    @id @default(uuid())
  userId              String                    @unique
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String
  businessDescription String?
  gstNumber           String?

  verificationStatus  SellerVerificationStatus  @default(UNSUBMITTED)
  verificationNote    String?
  reviewedById        String?
  reviewedBy          User?                     @relation("VerificationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?

  // Payout details. NOTE: for a real production deployment, prefer a payment
  // processor's connected-accounts API (e.g. Razorpay Route) over storing raw
  // bank details, or encrypt these columns at rest — kept simple here to match
  // the spec's "Seller Profile with bank account details for payouts".
  bankAccountHolder   String?
  bankAccountNumber   String?
  bankIfscCode        String?
  bankName            String?

  serviceAreaLat      Float?
  serviceAreaLng      Float?
  serviceAreaRadiusKm Float?

  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([verificationStatus])
  @@map("seller_profiles")
}

// ---------------------------------------------------------------------------
// 3.12 Notifications & Feedback
// ---------------------------------------------------------------------------

model Notification {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  message           String
  isRead            Boolean           @default(false)
  relatedEntityType String?           // e.g. "ORDER", "SELLER_PROFILE"
  relatedEntityId   String?
  createdAt         DateTime          @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id            String             @id @default(uuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled  Boolean            @default(true)
  inAppEnabled  Boolean            @default(true)
  mutedTypes    NotificationType[] @default([])
  updatedAt     DateTime           @updatedAt

  @@map("notification_preferences")
}

model Feedback {
  id             String           @id @default(uuid())
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  category       FeedbackCategory @default(GENERAL)
  subject        String
  message        String
  status         FeedbackStatus   @default(OPEN)
  adminResponse  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@map("feedback")
}

// ---------------------------------------------------------------------------
// 3.8 Mandi Price Intelligence
// ---------------------------------------------------------------------------

model Mandi {
  id          String   @id @default(uuid())
  name        String
  state       String
  district    String
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices      MandiPrice[]
  favoritedBy FavoriteMandi[]
  priceAlerts MandiPriceAlert[]

  @@unique([name, state, district])
  @@index([state, district])
  @@map("mandis")
}

model Crop {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String?  // e.g. "Cereals", "Vegetables", "Pulses", "Spices"
  unit      String   @default("Quintal")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices      MandiPrice[]
  priceAlerts MandiPriceAlert[]

  @@map("crops")
}

model MandiPrice {
  id         String           @id @default(uuid())
  mandiId    String
  mandi      Mandi            @relation(fields: [mandiId], references: [id], onDelete: Cascade)
  cropId     String
  crop       Crop             @relation(fields: [cropId], references: [id], onDelete: Cascade)
  variety    String?          // Agmarknet-style variety label, e.g. "Local", "Basmati"
  minPrice   Decimal          @db.Decimal(10, 2)
  maxPrice   Decimal          @db.Decimal(10, 2)
  modalPrice Decimal          @db.Decimal(10, 2) // the "typical" price — what most alerts/charts key off
  priceDate  DateTime         @db.Date // the market date this record is FOR, not when it was entered
  source     MandiPriceSource @default(ADMIN)
  createdAt  DateTime         @default(now())

  @@unique([mandiId, cropId, variety, priceDate])
  @@index([cropId, mandiId, priceDate])
  @@index([priceDate])
  @@map("mandi_prices")
}

model FavoriteMandi {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mandiId   String
  mandi     Mandi    @relation(fields: [mandiId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, mandiId])
  @@index([userId])
  @@map("favorite_mandis")
}

model MandiPriceAlert {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropId          String
  crop            Crop                @relation(fields: [cropId], references: [id], onDelete: Cascade)
  mandiId         String?             // null = alert across any mandi
  mandi           Mandi?              @relation(fields: [mandiId], references: [id], onDelete: Cascade)
  priceType       MandiPriceType      @default(MODAL)
  condition       PriceAlertCondition
  thresholdPrice  Decimal             @db.Decimal(10, 2)
  isActive        Boolean             @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([cropId, mandiId, isActive])
  @@index([userId])
  @@map("mandi_price_alerts")
}

// ---------------------------------------------------------------------------
// 3.10 Weather Intelligence
// ---------------------------------------------------------------------------

model WeatherCache {
  id          String   @id @default(uuid())
  locationKey String   @unique // rounded "lat,lng" — see weather.service.ts
  latitude    Float
  longitude   Float
  currentData Json
  dailyData   Json
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("weather_cache")
}

// ---------------------------------------------------------------------------
// 3.5 Seed Store — a genuinely independent sub-marketplace: its own catalog,
// cart, checkout, orders, payments, reviews, and wishlist, mirroring the
// main commerce system's shape rather than reusing Product/Order/Payment.
// Reuses OrderStatus/PaymentStatus (identical semantics, no reason to fork
// those enums too). The AI seed advisor mentioned alongside this in the
// original spec is deliberately NOT part of this — it belongs with the
// AI Farm Advisory module (3.9), which needs its own provider decision.
// ---------------------------------------------------------------------------

model SeedCategory {
  id            String   @id @default(uuid())
  name          String   @unique
  slug          String   @unique
  description   String?
  imageUrl      String?
  imagePublicId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  seeds         Seed[]

  @@map("seed_categories")
}

model Seed {
  id                     String       @id @default(uuid())
  sellerId               String
  seller                 User         @relation("SellerSeeds", fields: [sellerId], references: [id], onDelete: Cascade)
  seedCategoryId         String
  seedCategory           SeedCategory @relation(fields: [seedCategoryId], references: [id])

  name                   String
  slug                   String       @unique
  description            String?
  brand                  String?
  variety                String?      // e.g. "JS-9560" — supports the spec's "seed variety comparison"
  sowingSeason           String?      // e.g. "Kharif", "Rabi", "Zaid"
  germinationRatePercent Int?

  price                  Decimal      @db.Decimal(12, 2)
  discountPrice          Decimal?     @db.Decimal(12, 2)
  stock                  Int          @default(0)
  unit                   String       @default("kg")
  specifications         Json?
  latitude               Float?
  longitude              Float?
  isActive               Boolean      @default(true)
  avgRating              Float        @default(0)
  reviewCount            Int          @default(0)
  viewCount              Int          @default(0)

  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  images                 SeedImage[]
  variants               SeedVariant[]
  reviews                SeedReview[]
  wishlistedBy           SeedWishlist[]
  cartItems              SeedCartItem[]
  orderItems             SeedOrderItem[]

  @@index([seedCategoryId])
  @@index([sellerId])
  @@index([isActive])
  @@map("seeds")
}

model SeedImage {
  id        String   @id @default(uuid())
  seedId    String
  seed      Seed     @relation(fields: [seedId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([seedId])
  @@map("seed_images")
}

model SeedVariant {
  id         String   @id @default(uuid())
  seedId     String
  seed       Seed     @relation(fields: [seedId], references: [id], onDelete: Cascade)
  name       String   // e.g. "5kg pack"
  sku        String?  @unique
  price      Decimal  @db.Decimal(12, 2)
  stock      Int      @default(0)
  attributes Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cartItems  SeedCartItem[]
  orderItems SeedOrderItem[]

  @@index([seedId])
  @@map("seed_variants")
}

model SeedReview {
  id         String   @id @default(uuid())
  seedId     String
  seed       Seed     @relation(fields: [seedId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([seedId, userId])
  @@index([seedId])
  @@map("seed_reviews")
}

model SeedWishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seedId    String
  seed      Seed     @relation(fields: [seedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, seedId])
  @@index([userId])
  @@map("seed_wishlist")
}

model SeedCart {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     SeedCartItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("seed_carts")
}

model SeedCartItem {
  id        String       @id @default(uuid())
  cartId    String
  cart      SeedCart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  seedId    String
  seed      Seed         @relation(fields: [seedId], references: [id], onDelete: Cascade)
  variantId String?
  variant   SeedVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([cartId, seedId, variantId])
  @@index([cartId])
  @@map("seed_cart_items")
}

model SeedOrder {
  id            String                   @id @default(uuid())
  orderNumber   String                   @unique
  userId        String
  user          User                     @relation(fields: [userId], references: [id])
  addressId     String
  address       Address                  @relation(fields: [addressId], references: [id])
  status        OrderStatus              @default(PENDING)

  subtotal      Decimal                  @db.Decimal(12, 2)
  shippingFee   Decimal                  @db.Decimal(12, 2) @default(0)
  tax           Decimal                  @db.Decimal(12, 2) @default(0)
  discount      Decimal                  @db.Decimal(12, 2) @default(0)
  totalAmount   Decimal                  @db.Decimal(12, 2)

  notes         String?
  cancelReason  String?

  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  items         SeedOrderItem[]
  statusHistory SeedOrderStatusHistory[]
  payment       SeedPayment?

  @@index([userId])
  @@index([status])
  @@map("seed_orders")
}

model SeedOrderItem {
  id         String       @id @default(uuid())
  orderId    String
  order      SeedOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seedId     String
  seed       Seed         @relation(fields: [seedId], references: [id])
  variantId  String?
  variant    SeedVariant? @relation(fields: [variantId], references: [id])
  seedName   String       // snapshot at time of order
  quantity   Int
  unitPrice  Decimal      @db.Decimal(12, 2)
  totalPrice Decimal      @db.Decimal(12, 2)

  @@index([orderId])
  @@map("seed_order_items")
}

model SeedOrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  order       SeedOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  changedById String?
  changedBy   User?       @relation("SeedStatusChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime    @default(now())

  @@index([orderId])
  @@map("seed_order_status_history")
}

model SeedPayment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             SeedOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId            String
  user              User          @relation(fields: [userId], references: [id])

  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpaySignature String?

  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String?
  failureReason     String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([razorpayOrderId])
  @@map("seed_payments")
}

// ---------------------------------------------------------------------------
// 3.7 Machinery & Equipment Rental
//
// Fundamentally different shape from the product/seed catalogs: a listing's
// "stock" (totalUnits) isn't a running counter you decrement — availability
// is a function of DATE RANGE, computed by summing quantities from bookings
// that overlap the requested range (including a mandatory buffer period
// after each booking, before the same units can be booked again). See
// machineryAvailability.service.ts for the overlap math and why booking
// creation runs in a Serializable transaction rather than a plain one.
// ---------------------------------------------------------------------------

model MachineryCategory {
  id          String      @id @default(uuid())
  name        String      @unique
  slug        String      @unique
  description String?
  imageUrl    String?
  imagePublicId String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  machinery   Machinery[]

  @@map("machinery_categories")
}

model Machinery {
  id             String              @id @default(uuid())
  sellerId       String
  seller         User                @relation("SellerMachinery", fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId     String
  category       MachineryCategory   @relation(fields: [categoryId], references: [id])

  name           String
  slug           String              @unique
  description    String?
  brand          String?
  model          String?

  totalUnits     Int                 @default(1) // fleet size — how many identical units the seller owns
  pricePerDay    Decimal             @db.Decimal(12, 2)
  bufferDays     Int                 @default(1) // recovery days required between bookings of the same unit(s)
  specifications Json?
  latitude       Float?
  longitude      Float?
  isActive       Boolean             @default(true)
  avgRating      Float               @default(0)
  reviewCount    Int                 @default(0)
  viewCount      Int                 @default(0)

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  images         MachineryImage[]
  discountTiers  MachineryDiscountTier[]
  bookings       MachineryBooking[]
  reviews        MachineryReview[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([isActive])
  @@map("machinery")
}

model MachineryImage {
  id          String    @id @default(uuid())
  machineryId String
  machinery   Machinery @relation(fields: [machineryId], references: [id], onDelete: Cascade)
  url         String
  publicId    String?
  isPrimary   Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([machineryId])
  @@map("machinery_images")
}

/// "Book this many units, get this % off" — the highest tier whose
/// minQuantity the booking meets or exceeds applies (best discount you
/// qualify for, not a stack of every tier crossed).
model MachineryDiscountTier {
  id              String    @id @default(uuid())
  machineryId     String
  machinery       Machinery @relation(fields: [machineryId], references: [id], onDelete: Cascade)
  minQuantity     Int
  discountPercent Decimal   @db.Decimal(5, 2)
  createdAt       DateTime  @default(now())

  @@unique([machineryId, minQuantity])
  @@map("machinery_discount_tiers")
}

model MachineryBooking {
  id                     String                 @id @default(uuid())
  bookingNumber          String                 @unique
  machineryId            String
  machinery              Machinery              @relation(fields: [machineryId], references: [id])
  userId                 String
  user                   User                   @relation(fields: [userId], references: [id])
  addressId              String?                // delivery address; omitted if the renter picks up
  address                Address?               @relation(fields: [addressId], references: [id])

  quantity               Int
  startDate              DateTime               @db.Date
  endDate                DateTime               @db.Date

  pricePerDaySnapshot     Decimal               @db.Decimal(12, 2)
  discountPercentApplied  Decimal               @db.Decimal(5, 2) @default(0)
  subtotal                Decimal               @db.Decimal(12, 2)
  tax                     Decimal               @db.Decimal(12, 2) @default(0)
  totalAmount             Decimal               @db.Decimal(12, 2)

  status                 MachineryBookingStatus @default(PENDING)
  notes                  String?
  cancelReason           String?

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  statusHistory          MachineryBookingStatusHistory[]
  payment                MachineryPayment?
  review                 MachineryReview?

  // Every availability/conflict check filters by machineryId and scans
  // date ranges — this index is what makes that scan cheap instead of a
  // full table scan per lookup.
  @@index([machineryId, startDate, endDate])
  @@index([userId])
  @@index([status])
  @@map("machinery_bookings")
}

model MachineryBookingStatusHistory {
  id          String                 @id @default(uuid())
  bookingId   String
  booking     MachineryBooking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status      MachineryBookingStatus
  note        String?
  changedById String?
  changedBy   User?                  @relation("MachineryStatusChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime               @default(now())

  @@index([bookingId])
  @@map("machinery_booking_status_history")
}

model MachineryPayment {
  id                String           @id @default(uuid())
  bookingId         String           @unique
  booking           MachineryBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId            String
  user              User             @relation(fields: [userId], references: [id])

  razorpayOrderId   String           @unique
  razorpayPaymentId String?
  razorpaySignature String?

  amount            Decimal          @db.Decimal(12, 2)
  currency          String           @default("INR")
  status            PaymentStatus    @default(CREATED)
  method            String?
  failureReason     String?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@index([razorpayOrderId])
  @@map("machinery_payments")
}

model MachineryReview {
  id          String            @id @default(uuid())
  machineryId String
  machinery   Machinery         @relation(fields: [machineryId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId   String?           @unique // optional link proving they actually rented it
  booking     MachineryBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  rating      Int
  comment     String?
  isApproved  Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([machineryId, userId])
  @@index([machineryId])
  @@map("machinery_reviews")
}
